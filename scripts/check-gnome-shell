#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-only
"""Run native GNOME UI tests in a private shell; never connect to Bluetooth."""
import argparse
import os
import re
from pathlib import Path
import shutil
import signal
import subprocess
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parents[1]
UUID = 'veazy@xenophon81.github.io'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--session', choices=['wayland', 'x11'], default='wayland')
    parser.add_argument('--screenshots', type=Path)
    parser.add_argument('--verbose', action='store_true')
    args = parser.parse_args()
    for tool in ['gnome-shell', 'gsettings', 'dbus-run-session'] + (['Xephyr'] if args.session == 'x11' else []):
        if not shutil.which(tool):
            parser.exit(1, f'Missing test dependency: {tool}\n')
    with tempfile.TemporaryDirectory(prefix='veazy-shell-check-') as name:
        temp = Path(name)
        package = temp / 'extension.zip'
        subprocess.run(['python3', str(ROOT / 'scripts/gnome-extension'), 'build', '--output', str(package)], check=True, stdout=subprocess.DEVNULL)
        extensions = temp / 'data/gnome-shell/extensions'
        with zipfile.ZipFile(package) as archive:
            archive.extractall(extensions / UUID)
        shutil.copytree(ROOT / 'tests/gnome/shell', extensions / 'veazy-test@local')
        for folder in ['config', 'cache', 'runtime', 'screenshots']:
            (temp / folder).mkdir(mode=0o700)
        # User/system Bluetooth imports are forbidden even if a UI regression
        # accidentally launches a worker. Tests remain offline.
        guard = temp / 'no-hardware'
        guard.mkdir()
        (guard / 'bleak.py').write_text('raise RuntimeError("Bluetooth imports are forbidden in GNOME UI tests")\n')
        env = os.environ.copy()
        env.update(XDG_DATA_HOME=str(temp / 'data'), XDG_CONFIG_HOME=str(temp / 'config'),
                   XDG_CACHE_HOME=str(temp / 'cache'), XDG_RUNTIME_DIR=str(temp / 'runtime'),
                   GSETTINGS_BACKEND='keyfile', GNOME_SHELL_SESSION_MODE='user',
                   LIBGL_ALWAYS_SOFTWARE='1', VEAZY_TEST_OUTPUT=str(temp / 'screenshots'),
                   VEAZY_TEST_CAPTURE='1' if args.session == 'wayland' else '0',
                   PYTHONPATH=str(guard), GVFS_DISABLE_FUSE='1', NO_AT_BRIDGE='1')
        env.pop('WAYLAND_DISPLAY', None)
        env.pop('SESSION_MANAGER', None)
        xserver = None
        try:
            if args.session == 'x11':
                # Xephyr chooses a free display through -displayfd. The parent
                # desktop is used only for this temporary nested X server window.
                read_fd, write_fd = os.pipe()
                xserver = subprocess.Popen(['Xephyr', '-displayfd', str(write_fd), '-screen', '1280x1000', '-nolisten', 'tcp', '-noreset'],
                                           env=os.environ, pass_fds=(write_fd,), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                           start_new_session=True)
                os.close(write_fd)
                import select
                if not select.select([read_fd], [], [], 10)[0]:
                    os.close(read_fd)
                    raise RuntimeError('Nested X server did not become ready')
                with os.fdopen(read_fd) as pipe:
                    display = pipe.readline().strip()
                if not display.isdecimal():
                    raise RuntimeError('Nested X server failed')
                env['DISPLAY'] = ':' + display
                shell_args = ['--x11', '--sm-disable', '--mode=user']
            else:
                env.pop('DISPLAY', None)
                shell_args = ['--headless', '--wayland', '--virtual-monitor=1280x1000', '--no-x11', '--sm-disable', '--mode=user']
            # Fixed script and argv; no device data or path interpolation in shell.
            command = ['dbus-run-session', '--', 'bash', '-c',
                       'gsettings set org.gnome.shell enabled-extensions "[\'veazy@xenophon81.github.io\',\'veazy-test@local\']"; exec gnome-shell "$@"',
                       'veazy-check', *shell_args]
            process = subprocess.Popen(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
            try:
                output, _ = process.communicate(timeout=35)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGTERM)
                output, _ = process.communicate(timeout=5)
                raise RuntimeError('GNOME UI test timed out\n' + output[-6000:])
            finally:
                try:
                    os.killpg(process.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            if args.verbose or 'VEAZY_SHELL_OK' not in output or 'VEAZY_SHELL_FAIL' in output:
                print(output)
            if 'VEAZY_SHELL_OK' not in output or 'VEAZY_SHELL_FAIL' in output or f'Extension {UUID}:' in output:
                raise RuntimeError('GNOME UI test failed')
            if args.screenshots:
                args.screenshots.mkdir(parents=True, exist_ok=True)
                for source in (temp / 'screenshots').glob('*.png'):
                    shutil.copyfile(source, args.screenshots / source.name)
            count = re.search(r'VEAZY_SHELL_OK (\d+)', output).group(1)
            captures = len(list((temp / 'screenshots').glob('*.png')))
            print(f'GNOME 46 / {args.session}: PASS ({count} native UI assertions, {captures} screenshots, no Bluetooth)')
        finally:
            if xserver:
                xserver.terminate()
                try:
                    xserver.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    xserver.kill()


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit(str(error))
